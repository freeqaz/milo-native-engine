// Per-target web config header, force-included into every TU of an Emscripten
// consumer target. Generated by milo_engine_set_web_canvas_selector() in the
// engine's top-level CMakeLists.txt via configure_file().
//
// The `#` in the DOM-id string (e.g. "#dc3-canvas") prevents CMake from
// passing the value as a -D macro on the compiler command line, so we route
// it through this header instead. See the helper's doc-comment for details.
#pragma once

#ifndef MILO_WEB_CANVAS_SELECTOR
#define MILO_WEB_CANVAS_SELECTOR "@MILO_WEB_CANVAS_SELECTOR@"
#endif
